# URL base del backend principal (usuarios, artículos, trastornos).
# Si se deja vacío, la aplicación usará el adaptador local mockApi.
VITE_API_URL=

# Clave privada de Google Gemini API (solo servidor / Vercel Serverless, nunca en el cliente).
GEMINI_API_KEY=

# Lista separada por comas de orígenes HTTPS autorizados para /api/ai/* en producción.
# Ejemplo: https://mental-health-git-main-soyandrey20s-projects.vercel.app
ALLOWED_ORIGINS=